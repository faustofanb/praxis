import { describe, expect, it } from 'vitest';

import { mapMesPadValue } from './map-mes-pad-value';

describe('mapMesPadValue', () => {
  it('maps the API field to the value displayed by MES PAD', () => {
    const result = mapMesPadValue({ sourceField: 'expected value' });

    expect(result).toBe('expected value');
  });
});

