{
  "schemaVersion": 1,
  "role": "delivery-agent",
  "purpose": "Delivery readiness audit and command preparation after explicit closeout confirmation.",
  "input_required": [
    "requirementDir",
    "readinessJson",
    "guardOutput",
    "changeCheckOutput",
    "commitList",
    "confirmedCommitAllowlist"
  ],
  "output_required": [
    "readiness",
    "blockers",
    "commands_checked",
    "confirmed_commits",
    "excluded_commits",
    "candidate_audit",
    "required_confirmations"
  ],
  "forbidden": [
    "bypass_user_confirmation",
    "implicit_non_test_commit_filtering",
    "include_local_test_commits",
    "include_test_support_without_confirmation",
    "delete_without_confirmation"
  ],
  "verdict_values": [
    "ready",
    "blocked",
    "needs-confirmation"
  ]
}
