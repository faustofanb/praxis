{
  "name": "praxis-harness",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "lint": "biome lint .",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:replay": "vitest run tests/replay",
    "test:fault": "vitest run tests/fault",
    "test:security": "vitest run tests/security",
    "test:store": "bun test tests/store",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@praxis/cli": "0.0.0",
    "@praxis/contracts": "0.0.0",
    "@praxis/core": "0.0.0",
    "@praxis/provider-openai": "0.0.0",
    "@praxis/store-sqlite": "0.0.0",
    "@praxis/testkit": "0.0.0",
    "@praxis/tools-local": "0.0.0",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.9.0",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  }
}
